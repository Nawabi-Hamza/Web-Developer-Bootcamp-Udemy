<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Create | Product</title>
    <style>
        .btn-primary{
            background-color: darkcyan !important;
        }
        .btn-outline-primary{
            border-color: darkcyan;
            color: darkcyan;
        }
        .btn-outline-primary:hover{
            background-color: darkcyan !important;
        }
        .btn-outline-primary:focus{
            outline-color: darkcyan !important;
            box-shadow:none !important;
        }
        .btn-outline-primary:active{
            background-color: rgba(0, 139, 139, 0.295) !important;
            border: none !important;
        }
    </style>
    </style>
</head>
<body>
    <div class="container">
        <div class="row offset-lg-3 my-5">
            <div class="col-12 col-lg-8">
                <h1>Add A Farm</h1><br>
                <form action="/farms" method="POST" novalidate class="is-valid">
                    <div class="mb-3">
                        <label for="name" class="form-label">Farm Name:</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="city" class="form-label" >City:</label>
                        <input type="text"  class="form-control" id="city" name="city"  required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label" >Email:</label>
                        <input type="email"  class="form-control" id="email" name="email"  required>
                    </div>
                    <!-- <div class="mb-3">
                        <label for="product" class="form-label">Product</label>
                        <select name="products" id="product" class="form-select">
                                <% for(let pro of product){ %>
                                    <option value="<%= pro.id %>" ><%= pro.name %></option>
                                <% } %>
                        </select>
                    </div> -->
                        <button type="submit" class="btn btn-primary">Create Product</button>
                        <a href="/products" class="btn btn-outline-primary">Cancel</a>
                </form>
            </div>
        </div>
    </div>

    <footer>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
    </footer>
</body>
</html>
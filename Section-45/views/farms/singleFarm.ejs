<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <title><%= farm.name %> | Farm</title>
</head>
<body>
    <div class="container">
        <h1 class="fw-bold"><%= farm.name %></h1>
        <hr>
        <div class="container">
            <p class="fw-bold">City: <%= farm.city %></p>
            <p class="fw-bold">Email: <%= farm.email %></p>
            <h3 class="fw-bold">Products</h3>
            <ul>
                <% for(let product of farm.products){ %>
                    <li><a href="/products/<%= product.id %>"><%= product.name %></a></li>
                <% } %>
            </ul>
        </div>
        <div>
            <div class="d-flex">
                <a class="nav-link" href="/farms/<%= farm._id %>/products/new">
                    <button class="rounded rounded-3 p-2 pb-3 ">
                        Add Product
                    </button>
                </a>
                <a class="nav-link" href="/farms">
                    <button class=" rounded rounded-3 p-2">
                        <img src="https://img.icons8.com/?id=64975&format=png&color=000000" height="30" width="30" alt="">
                    </button>
                </a>
                <form action="/farms/<%= farm.id %>?_method=DELETE" method="POST">
                    <button type="submit" class="mt-2 rounded rounded-3 p-2">
                        <img src="https://img.icons8.com/?id=isPYXsxrQrzW&format=png&color=000000" height="30" width="30" alt="">
                    </button>
                </form>
                <a class="nav-link" href="/farms/<%= farm.id %>/edit">
                    <button class=" rounded rounded-3 p-2">
                        <img src="https://img.icons8.com/?id=oKUCzFUhxTq7&format=png&color=000000" height="30" width="30" alt="">
                    </button>
                </a>
            </div>
            <hr>    
        </div>
    </div>

    <footer>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
    </footer>
</body>
</html>
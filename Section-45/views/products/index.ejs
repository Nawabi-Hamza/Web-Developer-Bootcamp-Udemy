<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <a target="_blank" href="https://icons8.com/icon/67571/more"></a> 
    <a target="_blank" href="https://icons8.com"></a>
    <title>All Products</title>
    <style>
        a{
            text-decoration: none;
        }
        .mycard{
            transition: .5s;
            border-radius: 1.2em;
        }
        .mycard:hover{
            background-color: darkcyan;
            color: white;
            outline: 2px solid darkcyan;
            outline-offset: 3px;
        }
        .btn-primary{
            background-color: darkcyan !important;
        }
    </style>
</head>
<body>       
    <div class="container">
        <br><br>
        <h1><%= category.toUpperCase() %> Products</h1><br>
        <div>
            <a href="/farms"><button class="btn btn-primary">Farm Page &gt;</button></a>
        </div><br>
        <div>
            <a href="/products/new"><button class="btn btn-primary">Create new product</button></a>
            <a href="/farms/new"><button class="btn btn-primary">Create new Farm</button></a>
        </div><br>
        <div class="d-flex justify-content-between my-2 p-3 sticky-top bg-light">
            <h3>Search:</h3>
            <div>
                <% if(category!=='All'){ %>
                    <a href="/products" class="btn btn-primary m-1">All</a>
                <% } %>
                <% for(let cate of categories){ %>
                    <% if(category!==cate){ %>
                        <a href="/products?category=<%= cate %>" class="btn btn-primary m-1"><%= cate %></a>
                    <% } %>
                <% } %>
            </div>
        </div>
        <div class="container">
            <div class="row justify-content-start">
             <% for(let product of products){ %>
                <div class="col-12 col-lg-6 col-xl-4 p-2">
                    <div class="mycard border border-1 py-5 px-4 d-flex gap-4 justify-content-between">
                        <h3>
                            <%= product.name  %>
                        </h3>
                        <div class="d-flex">
                            <a href="/products/<%= product.id%>">
                                <button class="border-0 bg-white m-1">
                                    <img src="https://img.icons8.com/?id=67571&format=png&color=000000" height="30" width="30" alt="">
                                </button>
                            </a>
                            <form action="/products/<%= product.id %>?_method=DELETE" method="POST">
                                <button type="submit" class="border-0 bg-white m-1">
                                    <img src="https://img.icons8.com/?id=isPYXsxrQrzW&format=png&color=000000" height="30" width="30" alt="">
                                </button>
                            </form>
                            <a href="/products/<%= product.id %>/edit">
                                <button class="border-0 bg-white m-1">
                                    <img src="https://img.icons8.com/?id=oKUCzFUhxTq7&format=png&color=000000" height="30" width="30" alt="">
                                </button>
                            </a>
                        </div>
                    </div>
                </div>
             <% } %>
            </div>
        </div>
    </div> 
    <footer>
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
    </footer>
</body>
</html>
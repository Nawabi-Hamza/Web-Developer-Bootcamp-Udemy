



<% layout('layouts/boilerplate') %>



<h1>All Campgorunds</h1>
<a href="/campgrounds/new" class="btn btn-info">Add Campground</a>
<br><br>
    <div class="row">
        <% let num = 10 %>
        <% for(let camp of campgrounds){ %>
        <div class="col-xl-6">
            <div class="card mb-3">
                <div class="row">
                    <div class="col-md-6 col-lg-5">
                        <img src="<%= camp.image=="https://picsum.photos/400"? camp.image.split('400')[0]+parseInt(parseInt(camp.image.split('/')[3])+num++):camp.image %>" class="img-fluid h-100 w-100 " style="object-fit: cover;"  alt="">
                    </div>
                    <div class="col-md-6 col-lg-7">
                        <div class="card-body">
                            <h4 class="card-title"><%= camp.title %></h4>
                            <p class="card-text"><%= camp.description %></p>
                            <p class="text-text">
                                <span class="text-muted"><%= camp.location %></span>
                            </p>
                            <a href="/campgrounds/<%= camp.id %>" class="btn btn-outline-info">View <%= camp.title %> &gt;</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Single Campground</title>
</head>
<body>
    <!-- <h1>CAMPGROUND SHOW</h1> -->
    <h1><%= campground.title %></h1>
